{
  "name": "tasklace",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop application to create, edit, share and export Gantt charts.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "lint": "tsc --noEmit && tsc --noEmit -p src/main && tsc --noEmit -p src/preload && tsc --noEmit -p src/renderer && tsc --noEmit -p tests && tsc --noEmit -p tests/e2e && eslint .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "format:check": "prettier --check .",
    "bench": "vitest run --config vitest.perf.config.ts",
    "bench:growth": "vitest run --config vitest.growth.config.ts",
    "test:e2e": "electron-vite build && playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "electron": "^44.4.5",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "yjs": "13.6.33"
  },
  "main": "out/main/index.js"
}
